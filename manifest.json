{
  "manifest_version": 3,
  "name": "eBay Price Wizard",
  "version": "1.5.2",
  "description": "Preview and fill CCTV kit variation prices and SKUs in compatible eBay listing grids.",
  "permissions": [],
  "host_permissions": [
    "https://*.ebay.co.uk/*",
    "https://*.ebay.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.ebay.co.uk/*",
        "https://*.ebay.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "version_name": "1.5.2"
}
